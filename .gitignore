# ───────────────────────── 密钥 / 环境变量 ─────────────────────────
# 切勿提交真实密钥。仅保留示例文件 .env.example
.env
.env.*
!.env.example
*.local

# ───────────────────────── 前端 (Node / Vite) ─────────────────────────
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/
coverage/

# ───────────────────────── 后端 (Python) ─────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ───────────────────────── 编辑器 / 系统 ─────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ───────────────────────── 工具 / 本地 ─────────────────────────
.claude/
# 文档默认不入库，仅放行截图目录（README 展示用；git 不会重新包含已排除目录内的文件，
# 所以必须写成 docs/* + !docs/screenshots/ 两行）
docs/*
!docs/screenshots/

# ───────────────────────── 备份归档 ─────────────────────────
*.zip
*.tar
*.tar.gz

# ───────────────────────── BI 报表数据集落盘 ─────────────────────────
# 个人本地数据，不入库（PRD-bi §5.4）
backend/app/data/bi_datasets/
# 城市级地图 GeoJSON 代理缓存（F-VZ-07 降级，按需在线下载）
backend/app/data/geo_cache/
# 数据探查自定义规则持久化（PRD-dataprofile F-RL-06，运行时创建）
backend/app/data/profile_rules/
# 数据建模平台（/modeling 子应用）的 SQLite 库。
# platform.db 作为演示库随仓库分发：Render 每次部署都会重新 clone 仓库，库里没有它，
# 线上就只会剩下 SEED_DEMO_DATA 注入的最小演示集（1 个项目 / 2 个模型）。
# 目录下其余运行时产物仍然忽略。
backend/data/*
!backend/data/platform.db
